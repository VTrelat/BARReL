SYSTEM

  mm0

SETS

  ND

CONSTANTS

  gg,ff

PROPERTIES



  gg : ND <-> ND  &


  gg = gg~  &


  id(ND) /\ gg = {}  &


  dom(gg) = ND &


  ff : ND <-> (ND +-> ND) &

  !(nn,fi).( nn : ND &
             fi : ND +-> ND
            =>
             (
               ((nn,fi) : ff)
              <=>
               ( fi : ND-{nn} --> ND  &
                 fi <: gg  &
                !SS.( SS : POW(ND)  &
                      nn : SS  &
                      fi~[SS]<: SS
                     =>
                      ND <: SS
                     )
               )
              )
            ) &


  ff : ND --> (ND +-> ND) 

VARIABLES

  ld,ts

INVARIANT

  ld : ND &
  ts : ND +-> ND

ASSERTIONS


  !(nn,fi).( nn : ND &
             fi : ND +-> ND &
             (nn,fi) : ff 
            =>
             fi/\fi~={}
           )

INITIALISATION

  ld :: ND ||
  ts :: ND +-> ND

OPERATIONS


  elect =
    BEGIN
      ld,ts:( ld : ND &
              ts : ND-{ld}-->ND &
              ts<: gg &
              !SS.( SS : POW(ND)  &
                    ld : SS  &
                    ts~[SS]<: SS
                   =>
                    ND <: SS
                   )
             )
    END ;


  progr = skip;

  send_ack = skip;


  contention = skip;
   

  send_msg = skip ;


  receive_cnf = skip ;


  solve_contention = skip

END
                    